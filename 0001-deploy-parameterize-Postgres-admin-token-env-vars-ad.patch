From 0ba5ec68f95824e7c41bd75ba9d63deb6cbc5a7d Mon Sep 17 00:00:00 2001
From: Person B <person-b@example.com>
Date: Sat, 26 Sep 2026 17:02:44 +0000
Subject: [PATCH 1/2] deploy: parameterize Postgres/admin-token env vars, add
 .env.example

---
 deploy/.env.example       | 15 +++++++++++++++
 deploy/docker-compose.yml | 16 +++++++++-------
 2 files changed, 24 insertions(+), 7 deletions(-)
 create mode 100644 deploy/.env.example

diff --git a/deploy/.env.example b/deploy/.env.example
new file mode 100644
index 0000000..f116833
--- /dev/null
+++ b/deploy/.env.example
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Copy this file to deploy/.env to override the dev-only defaults baked into
+# docker-compose.yml. deploy/.env is gitignored (see the root .gitignore) --
+# never commit real credentials, and these dev values are not real secrets.
+
+POSTGRES_USER=quotient
+POSTGRES_PASSWORD=quotient
+POSTGRES_DB=quotient
+
+# Compared in constant time by AdminService (step 4, not implemented yet).
+QUOTIENT_ADMIN_TOKEN=dev-admin-token
+
+# debug logs one line per RLS call (see CLAUDE.md §6); use info for quieter output.
+SPDLOG_LEVEL=debug
diff --git a/deploy/docker-compose.yml b/deploy/docker-compose.yml
index 12087e4..d3ae75e 100644
--- a/deploy/docker-compose.yml
+++ b/deploy/docker-compose.yml
@@ -10,19 +10,21 @@
 # against it.
 #
 # Run from the deploy/ directory: docker compose up -d
+# Copy .env.example to .env in this folder to override the dev-only defaults
+# below (docker compose reads deploy/.env automatically). Never commit .env.
 
 services:
   postgres:
     image: postgres:17
     environment:
-      POSTGRES_USER: quotient
-      POSTGRES_PASSWORD: quotient
-      POSTGRES_DB: quotient
+      POSTGRES_USER: ${POSTGRES_USER:-quotient}
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-quotient}
+      POSTGRES_DB: ${POSTGRES_DB:-quotient}
     ports: ["5432:5432"]
     volumes:
       - ../database:/docker-entrypoint-initdb.d:ro
     healthcheck:
-      test: ["CMD-SHELL", "pg_isready -U quotient"]
+      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-quotient}"]
       interval: 2s
       retries: 30
 
@@ -43,10 +45,10 @@ services:
       dockerfile: rate-limit-service/Dockerfile
       target: runtime
     environment:
-      QUOTIENT_PG_URL: postgresql://quotient:quotient@postgres:5432/quotient
+      QUOTIENT_PG_URL: postgresql://${POSTGRES_USER:-quotient}:${POSTGRES_PASSWORD:-quotient}@postgres:5432/${POSTGRES_DB:-quotient}
       QUOTIENT_REDIS_URL: tcp://redis:6379
-      QUOTIENT_ADMIN_TOKEN: dev-admin-token   # dev-only value, not a real secret
-      SPDLOG_LEVEL: debug                     # one log line per RLS call; see CLAUDE.md §6
+      QUOTIENT_ADMIN_TOKEN: ${QUOTIENT_ADMIN_TOKEN:-dev-admin-token}   # dev-only default, not a real secret
+      SPDLOG_LEVEL: ${SPDLOG_LEVEL:-debug}    # one log line per RLS call; see CLAUDE.md §6
     depends_on:
       postgres: { condition: service_healthy }
       redis: { condition: service_started }
-- 
2.43.0

